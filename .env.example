# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Required. Sign up at https://console.groq.com (no card required).
GROQ_API_KEY=

# Optional. Defaults shown below (see verified_cost_router/config.py).
# Override if Groq renames/retires a model -- no code change needed.
GROQ_CHEAP_MODEL=llama-3.1-8b-instant
GROQ_STRONG_MODEL=llama-3.3-70b-versatile
